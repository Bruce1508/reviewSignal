# ReviewSignal AI — local environment template
# Copy to .env and fill in. Never commit .env.
# Variable set is owned by docs/deployment.md §11.

APP_ENV=local

# PostgreSQL — system of record
DATABASE_URL=postgresql+psycopg://reviewsignal:reviewsignal@localhost:5432/reviewsignal

# Redis — queue and cache
REDIS_URL=redis://localhost:6379/0

# Google Business Profile OAuth (unused until PRD Phase 0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# Ollama — never hard-code the host (docs/deployment.md §14)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Benchmark the `evaluation_run` job scores against (docs/deployment.md §11).
# Unset fails the job rather than silently scoring the synthetic placeholder.
BENCHMARK_PATH=

# Session signing secret for the single-user admin session
SESSION_SECRET=change-me-in-local-env
# Operator password for the admin session. Unset locks the API rather than opening it.
OPERATOR_PASSWORD=change-me-in-local-env

# Fernet key encrypting OAuth tokens at rest in `source_credentials`.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
